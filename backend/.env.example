# Copia este archivo como .env (en esta carpeta backend) para probar en tu ordenador.
# En Render no hace falta: las variables se ponen en el panel (ver render.yaml).
# Una línea vacía como "NOMBRE=" cuenta como no puesta.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DATABASE_URL=
# Usuario del panel /admin (opcional)
DJANGO_ADMIN_USER=
DJANGO_ADMIN_PASSWORD=

# Cuentas de la app
ADMIN_EMAIL=tu@email.com
SIGNUP_CODE=
MAX_CALLS_PER_DAY=5
ALLOWED_COUNTRIES=ES,DE,FR,IT,PT,GB,IE,NL,BE,AT

# URL pública (la de ngrok en local; en Render se rellena sola)
PUBLIC_URL=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ENABLE_AMD=true
VALIDATE_TWILIO_SIGNATURE=true

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Cerebro (Gemma). Ollama Cloud por defecto; en local: OLLAMA_HOST=http://localhost:11434
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=

# Oído: whisper (open source, en el servidor) o elevenlabs (nube)
STT_PROVIDER=whisper
WHISPER_MODEL=small

# Telegram (crea el bot con @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Google Places (verificación automática de negocios)
GOOGLE_PLACES_API_KEY=

# --- Legal (salen en /legal/privacidad, /legal/terminos y /legal/negocios) ---
# Tu nombre (o el de tu empresa) como responsable del servicio
LEGAL_OWNER_NAME=
# Email de contacto para privacidad y para que los negocios pidan no recibir llamadas (por defecto, ADMIN_EMAIL)
LEGAL_CONTACT_EMAIL=
# Días que se guardan las conversaciones antes de borrarlas (el resultado se queda)
RETENTION_DAYS=30
